SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Format:
# account_key:api_key:base_currency,account_key_2:api_key_2:base_currency
# Example:
# TRADING212_ACCOUNTS=main:t212_live_xxx:GBP,isa:t212_live_yyy:GBP
TRADING212_ACCOUNTS=

# Optional Trading 212 API settings
TRADING212_BASE_URL=https://live.trading212.com
TRADING212_ACCOUNT_CASH_PATH=/api/v0/equity/account/cash
TRADING212_PORTFOLIO_PATH=/api/v0/equity/portfolio
TRADING212_TRANSACTIONS_PATH=/api/v0/history/transactions

# Optional export settings
EXPORT_DIR=exports
