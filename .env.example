# =========================
# Supabase
# =========================

SUPABASE_URL=https://your-project-id.supabase.co

# 推荐使用 service_role key。不要使用 sb_publishable_ 开头的 public key。
# 如果你使用的是 sb_secret_ 开头的 key，请确保依赖已升级到 requirements.txt 中的新版 supabase。
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =========================
# Trading 212
# =========================

# Live account:
TRADING212_BASE_URL=https://live.trading212.com

# Demo / practice account:
# TRADING212_BASE_URL=https://demo.trading212.com

# Trading 212 当前 API 需要 API Key + API Secret。
# 格式：
# account_key:api_key:api_secret:base_currency
#
# 多账号用英文逗号分隔：
# account_key_1:api_key_1:api_secret_1:base_currency,account_key_2:api_key_2:api_secret_2:base_currency
#
# account_key 是你自己给账号起的内部名字，可以叫 invest / stock_isa / main / isa。
# 示例：
# TRADING212_ACCOUNTS=invest:your_invest_api_key:your_invest_api_secret:GBP,stock_isa:your_isa_api_key:your_isa_api_secret:GBP

TRADING212_ACCOUNTS=invest:your_invest_api_key:your_invest_api_secret:GBP,stock_isa:your_isa_api_key:your_isa_api_secret:GBP

# =========================
# Trading 212 API Paths
# =========================

TRADING212_ACCOUNT_CASH_PATH=/api/v0/equity/account/summary
TRADING212_PORTFOLIO_PATH=/api/v0/equity/positions
TRADING212_TRANSACTIONS_PATH=/api/v0/equity/history/transactions

# =========================
# Export
# =========================

EXPORT_DIR=exports